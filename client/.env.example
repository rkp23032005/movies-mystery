VITE_API_URL=/api

# --- Movie images -----------------------------------------------------------------------------
# Default (leave unset): images load straight from TMDB's CDN. That is fine for <img> tags, but
# TMDB's CDN has had inconsistent CORS headers, so some posters may not be usable as WebGL
# textures (the Morph Gallery then skips them, or falls back to plain <img> tiles).
#
# To make every image same-origin (no CORS at all, WebGL always works), proxy them through this
# site: uncomment the line below. Dev uses the proxy in vite.config.js; production uses the
# rewrite in vercel.json. Check TMDB's terms and your host's bandwidth policy before enabling.
# VITE_IMAGE_BASE=/tmdb-img
